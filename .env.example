# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=yolo
MINIO_ROOT_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-three
# Bootstrap admin key, format yp_<prefix>_<secret>. Generate one with:
#   python3 -c "import secrets;print(f'yp_{secrets.token_hex(4)}_{secrets.token_urlsafe(32)}')"
ADMIN_API_KEY=

# Host ports (only nginx and Grafana are reachable from outside the host).
HTTP_PORT=8088
HTTPS_PORT=8443
GRAFANA_PORT=3001
PROMETHEUS_PORT=9091
MINIO_CONSOLE_PORT=9011
RTSP_PORT=8558

# Camera processing
CAMERA_SHARDS=2            # shard processes; each leases a fair share of enabled cameras
SHARD_MAX_CAMERAS=40
DECODE_BACKEND=nvdec       # nvdec (GPU) or cpu
VIDEO_WORKERS=1

# The API writes model-version uploads into inference/model_repository: run it as that
# directory's owner (id -u / id -g).
APP_UID=1000
APP_GID=1000

TRITON_IMAGE=nvcr.io/nvidia/tritonserver:25.10-py3
LOG_LEVEL=INFO
