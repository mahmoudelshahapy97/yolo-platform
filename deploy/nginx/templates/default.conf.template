# Rendered by the nginx image to /etc/nginx/conf.d/default.conf (replacing its
# default server); ${VAR} placeholders come from the container environment.
#
# Public entry point: TLS termination, request limits, WebSocket upgrade,
# same-origin access to presigned object-storage links (/storage/).
server_tokens off;

log_format platform '$remote_addr "$request" $status $body_bytes_sent rt=$request_time urt=$upstream_response_time';

# Outer guard per client IP; per-key limits are enforced by the API.
limit_req_zone $binary_remote_addr zone=per_ip:10m rate=100r/s;
limit_conn_zone $binary_remote_addr zone=conn_ip:10m;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream api { server api:8000; keepalive 64; }

server {
  listen 80;
  access_log /dev/stdout platform;
  location = /health/live { proxy_pass http://api; }
  location / { return 301 https://$host:${HTTPS_PORT}$request_uri; }
}

server {
  listen 443 ssl;
  access_log /dev/stdout platform;
  http2 on;
  ssl_certificate /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  client_max_body_size 64m;
  limit_conn conn_ip 200;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Connection "";
  proxy_read_timeout 120s;

  # Prometheus scrapes the API on the internal network only.
  location = /metrics { return 404; }

  location / {
    limit_req zone=per_ip burst=200 nodelay;
    proxy_pass http://api;
  }

  # Video uploads: large bodies streamed to the API (which streams to storage).
  location = /v1/infer/videos {
    client_max_body_size 2g;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_pass http://api;
  }

  # WebSockets: live camera events and job progress.
  location ~ ^/v1/(cameras|jobs)/[^/]+/stream$ {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_pass http://api;
  }

  # Presigned object-storage links (results, annotated videos). They are signed
  # for minio:9000, so the Host header must stay that.
  location /storage/ {
    proxy_set_header Host minio:9000;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_pass http://minio:9000/;
  }
}
