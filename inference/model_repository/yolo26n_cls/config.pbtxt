# Generated by inference/export/gen_config.py from build/yolo26n_cls/meta.json. Do not edit by hand.
name: "yolo26n_cls"
platform: "tensorrt_plan"
max_batch_size: 32

input [
  {
    name: "images"
    data_type: TYPE_UINT8
    dims: [ 224, 224, 3 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1000 ]
    label_filename: "labels.txt"
  }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16, 32 ]
  max_queue_delay_microseconds: 3000
  default_queue_policy {
    max_queue_size: 256
    timeout_action: REJECT
    default_timeout_microseconds: 500000
    allow_timeout_override: true
  }
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Serve only the version the registry activates (explicit model control loads
# versions deliberately; see api/app/services/model_registry.py).
version_policy: { latest: { num_versions: 1 } }

model_warmup [
  {
    name: "zeros"
    batch_size: 16
    inputs {
      key: "images"
      value: {
        data_type: TYPE_UINT8
        dims: [ 224, 224, 3 ]
        zero_data: true
      }
    }
  }
]

parameters { key: "task" value: { string_value: "classify" } }
